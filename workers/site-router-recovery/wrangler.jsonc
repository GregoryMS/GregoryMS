{
  "name": "gregle-site-router-recovery",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [{"pattern": "*.gregle.uk/*", "zone_name": "gregle.uk"}],
  "ratelimits": [
    {"name": "MAPS_SEARCH_LIMIT", "namespace_id": "2026111201", "simple": {"limit": 60, "period": 60}},
    {"name": "TOMTOM_ROUTE_LIMIT", "namespace_id": "2026110201", "simple": {"limit": 30, "period": 60}},
    {"name": "TOMTOM_TILE_LIMIT", "namespace_id": "2026110202", "simple": {"limit": 600, "period": 60}}
  ],
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true}
}
