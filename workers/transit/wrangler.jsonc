{
  "name": "gregle-transit",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"TRANSIT_FEEDS","class_name":"TransitFeed"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["TransitFeed"]}],
  "observability": {"enabled":true,"head_sampling_rate":0.1,"redact_query_string":true,"traces":{"enabled":true,"head_sampling_rate":0.1}}
}
